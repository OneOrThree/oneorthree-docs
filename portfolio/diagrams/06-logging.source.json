  "nodes": [
    {
      "id": "jvm",
      "x": 70,
      "y": 240,
      "w": 450,
      "h": 230,
      "title": "Business·Data·Realtime·Noti",
      "lines": [
        "ObservationJsonProvider → stdout",
        "schema_version=1 · log_id · timestamp",
        "service / env / version / log_kind",
        "request_id · dd.trace_id · 사건 ID",
        "허용 필드·민감값 마스킹·크기 제한"
      ],
      "kind": "core",
      "stage": "prod JSON · Business는 access 로그 포함",
      "state": "code"
    },
    {
      "id": "nginxLogs",
      "x": 655,
      "y": 240,
      "w": 450,
      "h": 230,
      "title": "nginx · access / error",
      "lines": [
        "access: JSON → /dev/stdout",
        "edge_request_id / upstream_request_id",
        "method · uri · status · request_time",
        "query·요청 헤더·client IP 제외",
        "error: /dev/stderr · warn 이상"
      ],
      "kind": "core",
      "stage": "Fluent Bit에서 정규화·경로 정제",
      "state": "code"
    },
    {
      "id": "docker",
      "x": 1240,
      "y": 240,
      "w": 450,
      "h": 230,
      "title": "Docker json-file",
      "lines": [
        "/var/lib/docker/containers/",
        "<id>/<id>-json.log",
        "앱·nginx: max-size 50m × 4",
        "두 수집기에 read-only mount",
        "회전 파일 .1 등은 Fluent Bit tail 제외"
      ],
      "kind": "data",
      "stage": "유한한 호스트 버퍼 · 장기 보관소 아님",
      "state": "code"
    },
    {
      "id": "ddAgent",
      "x": 70,
      "y": 680,
      "w": 450,
      "h": 270,
      "title": "앱 Datadog Agent · 512MiB",
      "lines": [
        "Docker 파일에서 로그 수집",
        "JVM tracer → :8126 APM",
        "JVM runtime → :8125 UDP",
        "Agent → 앱 :9091/actuator/prometheus",
        "허용한 Micrometer 지표만 수집",
        "JVM 부팅 잡음 필터는 DD 경로에만"
      ],
      "kind": "external",
      "stage": "app-network · DD_SITE 기본 us5",
      "state": "code"
    },
    {
      "id": "fluent",
      "x": 655,
      "y": 680,
      "w": 450,
      "h": 270,
      "title": "Fluent Bit 4.2.8 · 256MiB",
      "lines": [
        "host network · Docker 파일 read-only",
        "catus-app-v2 프로젝트만 허용",
        "app → data-api 이름 매핑",
        "네 서버·nginx 외 컨테이너 drop",
        "JSON parse / raw·nginx 정제·마스킹",
        "fluent_bit_state: tail.db + 버퍼",
        "Loki 원본 + S3 복제본을 따로 전송"
      ],
      "kind": "external",
      "stage": "tail → Lua → parser → Lua → outputs",
      "state": "code"
    },
    {
      "id": "hostAgents",
      "x": 1240,
      "y": 680,
      "w": 450,
      "h": 270,
      "title": "Kafka·Redis·백오피스 Agent",
      "lines": [
        "각 EC2에 별도 Datadog Agent",
        "각 호스트 Docker 로그·호스트 지표",
        "APM OFF · Agent 한도 256MiB",
        "Redis :6379/:6380 health 계정 체크",
        "이 세 호스트는 Fluent Bit 경로 없음",
        "Kafka JMX 별도 체크는 미설정"
      ],
      "kind": "external",
      "stage": "11/02 Agent health PASS 기록",
      "state": "code"
    },
    {
      "id": "datadog",
      "x": 70,
      "y": 1210,
      "w": 450,
      "h": 250,
      "title": "Datadog SaaS",
      "lines": [
        "Agent → HTTPS 전송",
        "로그·trace·호스트·컨테이너 지표",
        "로그에서 dd.trace_id로 APM 연결",
        "보관 기간: 조직 설정에서 확인",
        "dev V2에는 Agent 없음"
      ],
      "kind": "external",
      "stage": "Agent healthy ≠ SaaS 최신 수신",
      "state": "code"
    },
    {
      "id": "loki",
      "x": 655,
      "y": 1210,
      "w": 450,
      "h": 250,
      "title": "Loki 3.3.2 · 로컬 7일",
      "lines": [
        "Fluent Bit → 127.0.0.1:3100",
        "별도 observability network",
        "loki_data → /loki · 단일 인스턴스",
        "retention 168h + compactor ON",
        "라벨은 env / service / log_kind",
        "ID는 JSON 필드로 조회"
      ],
      "kind": "data",
      "stage": "app-network에 미연결 · 인증 없는 API",
      "state": "code"
    },
    {
      "id": "s3",
      "x": 1240,
      "y": 1210,
      "w": 450,
      "h": 250,
      "title": "S3 · system_log/v2/",
      "lines": [
        "gzip JSONL · env/service/date/hour",
        "10MiB 또는 5분 단위 업로드",
        "앱 EC2 IAM: prod 접두 쓰기만",
        "로그 만료 규칙: 90일",
        "Loki 청크 저장소가 아닌 별도 아카이브",
        "객체 파티션 시간 = 첫 레코드 시각"
      ],
      "kind": "data",
      "stage": "11/03 서비스별 S3 객체 확인 · retry 60",
      "state": "code"
    },
    {
      "id": "grafana",
      "x": 70,
      "y": 1730,
      "w": 450,
      "h": 230,
      "title": "Grafana · OFF",
      "lines": [
        "구성은 있으나 배포 스위치 false",
        "활성화 시 Loki datasource 사용",
        "Cloudflare Access JWT · JWKS/aud",
        "현재 Grafana 접속 주소 없음"
      ],
      "kind": "future",
      "stage": "대신 Datadog / 승인된 Loki 접근 사용",
      "state": "off"
    },
    {
      "id": "buffer",
      "x": 655,
      "y": 1730,
      "w": 450,
      "h": 230,
      "title": "유실·지연을 판별할 지점",
      "lines": [
        "Loki 엔진 버퍼 128MiB",
        "S3 엔진 64MiB + store_dir 64MiB",
        "상한·회전·재시도 소진 시 유실 가능",
        "canary 60초 간격 · 목적지별 도착 확인",
        "canary 도착 ≠ 모든 앱 로그 수집 성공"
      ],
      "kind": "external",
      "stage": "기존 canary 관찰 · 새 트래픽 생성 불필요",
      "state": "code"
    },
    {
      "id": "ua",
      "x": 1240,
      "y": 1730,
      "w": 450,
      "h": 230,
      "title": "Data user-activity · 별도 파일",
      "lines": [
        "additivity=false · stdout에 안 섞임",
        "/app/logs/user-activity.log",
        "호스트 /var/log/catus-V2/data-api",
        "로컬 30일 · 1GiB cap",
        "11/03 호스트: 파일 업로더 미설치"
      ],
      "kind": "future",
      "stage": "V2 버킷에 사용자 행동 객체 없음",
      "state": "off"
    },
    {
      "id": "httpIds",
      "x": 70,
      "y": 2170,
      "w": 450,
      "h": 190,
      "title": "HTTP → Business → Data",
      "lines": [
        "Business가 request_id 생성",
        "응답 X-Request-Id / 내부 호출 전파",
        "nginx upstream_request_id와 연결",
