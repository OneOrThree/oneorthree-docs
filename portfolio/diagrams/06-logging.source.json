      "kind": "core",
      "stage": "request_id를 APM trace ID로 쓰지 않음",
      "state": "code"
    },
    {
      "id": "eventIds",
      "x": 655,
      "y": 2170,
      "w": 450,
      "h": 190,
      "title": "outbox → Kafka/HTTP",
      "lines": [
        "event_id를 전달·재시도 동안 유지",
        "origin_request_id / origin_trace_id",
        "새 consumer trace와 원요청을 연결",
        "outbox.delivery → consumer.accept"
      ],
      "kind": "event",
      "stage": "저장한 carrier context를 비동기로 전파",
      "state": "code"
    },
