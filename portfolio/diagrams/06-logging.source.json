        "→ dispatch.settle",
        "operation_id / delivery_id / attempt",
        "FCM 성공 ≠ 기기 도착"
      ],
      "kind": "event",
      "stage": "dispatch.settle은 delivery_id+attempt",
      "state": "code"
    },
    {
      "id": "fanoutIds",
